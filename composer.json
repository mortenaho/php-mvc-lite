{
    "name": "phpmvc/lite",
    "description": "A lightweight, SOLID PHP MVC framework with Eloquent ORM and Blade views",
    "type": "project",
    "keywords": [
        "php",
        "mvc",
        "framework",
        "eloquent",
        "blade",
        "lite"
    ],
    "homepage": "https://github.com/mortenaho/php-mvc-lite",
    "license": "MIT",
    "authors": [
        {
            "name": "Mortenaho",
            "homepage": "https://mortenaho.ir"
        }
    ],
    "support": {
        "issues": "https://github.com/mortenaho/php-mvc-lite/issues",
        "source": "https://github.com/mortenaho/php-mvc-lite"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/pagination": "^12.0",
        "illuminate/view": "^12.0",
        "monolog/monolog": "^3.8",
        "nikic/fast-route": "^1.3",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Lite\\": "src/",
            "App\\": "app/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8000 -t public public/router.php",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php lite key:generate",
            "@php -r \"file_exists('storage/database/app.sqlite') || touch('storage/database/app.sqlite');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
