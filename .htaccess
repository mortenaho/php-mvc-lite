<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block sensitive project paths.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|src|storage|vendor)(/|$) - [F,L]
    RewriteRule ^(\.env|lite|composer\.(json|lock)|production\.env)$ - [F,L]

    # Existing files/directories (including /public/assets/*) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the root front controller.
    RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php public/index.php

<IfModule mod_authz_core.c>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

Options -Indexes
